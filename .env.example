# ==============================================================================
# AeroPulse Pune - Environment Configuration
# Real-Time Air Intelligence. Predictive Insights. Healthier Pune.
# ==============================================================================

# CPCB / data.gov.in Public Air Quality API Credentials
# Register and generate an API key at https://data.gov.in/
# If left empty, the application seamlessly activates the Pune Fallback Demo Layer.
DATA_GOV_API_KEY=
CPCB_API_KEY=

# data.gov.in Resource ID for Continuous Ambient Air Quality Monitoring (CAAQMS)
DATA_GOV_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Database Connection URL
# SQLite default: sqlite:///./pune_aqi.db
# PostgreSQL option: postgresql://user:password@localhost:5432/pune_aqi
DATABASE_URL=sqlite:///./pune_aqi.db

# Timezone standard
TIMEZONE=Asia/Kolkata
